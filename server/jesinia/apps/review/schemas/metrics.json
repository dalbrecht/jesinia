{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "SPDX-License-Identifier: AGPL-3.0-or-later",
  "$id": "https://jesinia.local/review/schemas/metrics.json",
  "title": "metrics",
  "description": "Scores (0 to 10) against criteria from the applied standards, each naming its rule.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scores"
  ],
  "properties": {
    "scores": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion",
          "rule",
          "score",
          "note"
        ],
        "properties": {
          "criterion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "rule": {
            "$ref": "#/$defs/rule"
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      },
      "maxItems": 100
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "layer"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "layer": {
          "enum": [
            "base",
            "repo",
            "user"
          ]
        }
      }
    }
  }
}
