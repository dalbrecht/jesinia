{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "SPDX-License-Identifier: AGPL-3.0-or-later",
  "$id": "https://jesinia.local/review/schemas/stack_walkthrough.json",
  "title": "stack_walkthrough",
  "description": "A walkthrough of a stack of PRs reviewed as one unit, in reading order.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "prs",
    "steps",
    "skipped"
  ],
  "properties": {
    "prs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "number",
          "summary"
        ],
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      },
      "minItems": 1,
      "maxItems": 50
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      },
      "maxItems": 400
    },
    "skipped": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skip"
      },
      "maxItems": 5000
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "body",
        "hunks"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "hunks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hunk"
          },
          "minItems": 1,
          "maxItems": 50
        }
      }
    },
    "hunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pr",
        "path",
        "hunk"
      ],
      "properties": {
        "pr": {
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "hunk": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "skip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pr",
        "path",
        "hunk",
        "reason"
      ],
      "properties": {
        "pr": {
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "hunk": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        },
        "reason": {
          "enum": [
            "generated",
            "lockfile",
            "vendored",
            "rename_only",
            "format_only",
            "judged_mechanical"
          ]
        }
      }
    }
  }
}
