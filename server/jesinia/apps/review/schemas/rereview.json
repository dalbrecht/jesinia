{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "SPDX-License-Identifier: AGPL-3.0-or-later",
  "$id": "https://jesinia.local/review/schemas/rereview.json",
  "title": "rereview",
  "description": "A follow-up review: what happened to each earlier finding, and new findings on the new commits.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "previous",
    "findings"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "previous": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding",
          "status",
          "note"
        ],
        "properties": {
          "finding": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "status": {
            "enum": [
              "addressed",
              "partly_addressed",
              "not_addressed",
              "obsolete"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 0,
            "maxLength": 2000
          }
        }
      },
      "maxItems": 200
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      },
      "maxItems": 200
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group",
        "severity",
        "path",
        "start_line",
        "end_line",
        "explanation",
        "rule"
      ],
      "properties": {
        "group": {
          "enum": [
            "correctness",
            "design",
            "style"
          ]
        },
        "severity": {
          "enum": [
            "critical",
            "important",
            "minor"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "rule": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/rule"
            }
          ]
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "layer"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "layer": {
          "enum": [
            "base",
            "repo",
            "user"
          ]
        }
      }
    }
  }
}
