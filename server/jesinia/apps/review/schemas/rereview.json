{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "SPDX-License-Identifier: AGPL-3.0-or-later",
  "$id": "https://jesinia.local/review/schemas/rereview.json",
  "title": "rereview",
  "description": "An incremental re-review: what the new commits did about each of the author's previous comments, and a walk through what is new since the previous review.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requests",
    "new_changes_walkthrough"
  ],
  "properties": {
    "requests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/request"
      },
      "maxItems": 500
    },
    "new_changes_walkthrough": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps",
        "skipped"
      ],
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          },
          "maxItems": 200
        },
        "skipped": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/skip"
          },
          "maxItems": 5000
        }
      }
    }
  },
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "comment_ref",
        "status",
        "explanation",
        "hunks"
      ],
      "properties": {
        "comment_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "status": {
          "enum": [
            "addressed",
            "partly",
            "not_addressed"
          ]
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "hunks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hunk"
          },
          "maxItems": 200
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "body",
        "hunks"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000
        },
        "hunks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hunk"
          },
          "minItems": 1,
          "maxItems": 50
        }
      }
    },
    "hunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "hunk"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "hunk": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "skip": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "hunk",
        "reason"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "hunk": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        },
        "reason": {
          "enum": [
            "generated",
            "lockfile",
            "vendored",
            "rename_only",
            "format_only",
            "judged_mechanical"
          ]
        }
      }
    }
  }
}
