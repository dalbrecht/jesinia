{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "SPDX-License-Identifier: AGPL-3.0-or-later",
  "$id": "https://jesinia.local/review/schemas/findings.json",
  "title": "findings",
  "description": "Review findings, each in one group (correctness, design, style), with a severity, a location, an explanation and the rule it applies.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "findings"
  ],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      },
      "maxItems": 200
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group",
        "severity",
        "path",
        "start_line",
        "end_line",
        "explanation",
        "rule"
      ],
      "properties": {
        "group": {
          "enum": [
            "correctness",
            "design",
            "style"
          ]
        },
        "severity": {
          "enum": [
            "critical",
            "important",
            "minor"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "rule": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/rule"
            }
          ]
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "layer"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "layer": {
          "enum": [
            "base",
            "repo",
            "user"
          ]
        }
      }
    }
  }
}
