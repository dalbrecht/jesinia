{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "SPDX-License-Identifier: AGPL-3.0-or-later",
  "$id": "https://jesinia.local/issues/schemas/queue.json",
  "title": "queue",
  "description": "Work queue proposals (Task 9): items to add next, an order for a queue, or which queue each item fits.",
  "type": "object",
  "additionalProperties": false,
  "required": ["mode", "items"],
  "properties": {
    "mode": {"enum": ["next", "order", "split"]},
    "items": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repo", "number", "reason"],
        "properties": {
          "kind": {"enum": ["issue", "epic", "milestone"]},
          "repo": {"type": "string", "minLength": 3, "maxLength": 140},
          "number": {"type": "integer", "minimum": 1, "maximum": 999999999},
          "position": {"type": "integer", "minimum": 1, "maximum": 1000},
          "queue": {"type": "string", "minLength": 1, "maxLength": 100},
          "reason": {"type": "string", "minLength": 1, "maxLength": 300}
        }
      }
    }
  }
}
