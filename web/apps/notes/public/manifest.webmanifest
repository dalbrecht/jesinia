    { "src": "/notes/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/notes/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/notes/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/notes/icons/monochrome-512.png", "sizes": "512x512", "type": "image/png", "purpose": "monochrome" }
  ]
}
