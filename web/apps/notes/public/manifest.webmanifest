{
  "name": "Jesinia Notes",
  "short_name": "Notes",
  "id": "/notes/",
  "start_url": "/notes/",
  "scope": "/notes/",
  "display": "standalone",
  "display_override": ["window-controls-overlay"],
  "theme_color": "#e3ece1",
